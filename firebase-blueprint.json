{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for customer, vendor or platform administrator",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["customer", "vendor", "admin"] },
        "phone": { "type": "string", "maxLength": 30 },
        "governorate": { "type": "string", "maxLength": 50 },
        "shopName": { "type": "string", "maxLength": 100 },
        "shopDescription": { "type": "string", "maxLength": 500 },
        "shopStatus": { "type": "string", "enum": ["active", "pending", "suspended"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Marketplace items offered by Tunisian merchants and craftsmen",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 2000 },
        "price": { "type": "number" },
        "comparePrice": { "type": "number" },
        "category": { "type": "string", "maxLength": 60 },
        "governorate": { "type": "string", "maxLength": 50 },
        "images": { "type": "array" },
        "stock": { "type": "number" },
        "vendorId": { "type": "string", "maxLength": 128 },
        "vendorName": { "type": "string", "maxLength": 100 },
        "vendorPhone": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["active", "draft", "archived"] },
        "featured": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "price", "category", "governorate", "vendorId"]
    },
    "Order": {
      "title": "Order",
      "description": "Tunisian marketplace order with customer info and items",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "shippingAddress": { "type": "string", "maxLength": 300 },
        "governorate": { "type": "string", "maxLength": 50 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shippingCost": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cod"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid"] },
        "orderStatus": { "type": "string", "enum": ["new", "processing", "shipped", "delivered", "cancelled"] },
        "platformCommissionRate": { "type": "number" },
        "vendorIds": { "type": "array" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["customerName", "customerPhone", "shippingAddress", "governorate", "items", "totalAmount"]
    },
    "Review": {
      "title": "Review",
      "description": "Product ratings and reviews from customers",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["productId", "userId", "rating", "comment"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Marketplace global configurations such as commission rates",
      "type": "object",
      "properties": {
        "commissionRate": { "type": "number" },
        "supportPhone": { "type": "string", "maxLength": 30 },
        "supportEmail": { "type": "string", "maxLength": 100 },
        "maintenanceMode": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["commissionRate"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and credentials"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products available in Soukna marketplace"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Purchased orders placed by customers"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Reviews left on products"
    },
    "/platform_settings/{settingId}": {
      "schema": "PlatformSettings",
      "description": "Administrative configurations"
    }
  }
}
